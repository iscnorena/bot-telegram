# --- Base de datos (Supabase / PostgreSQL) ---
# En Supabase CLOUD: usa la cadena "Connection pooling" (PgBouncer, puerto 6543)
# con ?pgbouncer=true&connection_limit=1.
# En LOCAL (npx supabase start) NO hay PgBouncer: usa la cadena directa tal cual.
# Este proyecto tiene los puertos locales remapeados a 553xx en supabase/config.toml
# (para coexistir con otro proyecto Supabase local). El puerto de la DB es 55322.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:55322/postgres"
# Conexión directa, SOLO para `prisma migrate` / `prisma db push`.
# Cloud: puerto 5432. Local: la misma que DATABASE_URL.
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:55322/postgres"

# --- Telegram ---
# Token que da @BotFather al crear el bot.
TELEGRAM_BOT_TOKEN=""
# Cadena aleatoria que tú eliges. Valida el header X-Telegram-Bot-Api-Secret-Token
# del webhook y también protege el endpoint dev (header X-Dev-Secret).
TELEGRAM_WEBHOOK_SECRET=""
# chat.id autorizado como proveedor (envía documentos y el comando "NO").
PROVEEDOR_TELEGRAM_CHAT_ID=""
# chat.id que recibe todas las notificaciones de administración.
ADMIN_TELEGRAM_CHAT_ID=""

# --- Auth.js (panel web del proveedor) ---
# Secreto para firmar el JWT de sesión. Genera uno con: npx auth secret
AUTH_SECRET=""
