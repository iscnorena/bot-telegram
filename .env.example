# --- Base de datos (Supabase / PostgreSQL) ---
# Conexión "pooled" (PgBouncer) para el runtime. En Supabase cloud es el puerto 6543.
# Local (npx supabase start): postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres?pgbouncer=true&connection_limit=1"
# Conexión directa, SOLO para `prisma migrate` / `prisma db push`. En Supabase cloud es el puerto 5432.
# Local: la misma cadena sin los parámetros de pgbouncer.
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# --- Telegram ---
# Token que da @BotFather al crear el bot.
TELEGRAM_BOT_TOKEN=""
# Cadena aleatoria que tú eliges. Valida el header X-Telegram-Bot-Api-Secret-Token
# del webhook y también protege el endpoint dev (header X-Dev-Secret).
TELEGRAM_WEBHOOK_SECRET=""
# chat.id autorizado como proveedor (envía documentos y el comando "NO").
PROVEEDOR_TELEGRAM_CHAT_ID=""
# chat.id que recibe todas las notificaciones de administración.
ADMIN_TELEGRAM_CHAT_ID=""
