# --- Base de datos (Supabase / PostgreSQL) ---
#
# LOCAL (npx supabase start): NO hay PgBouncer, usa la cadena directa tal cual en
# ambas. Este proyecto tiene los puertos locales remapeados a 553xx en
# supabase/config.toml; la DB local es el 55322.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:55322/postgres"
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:55322/postgres"
#
# PRODUCCIÓN (Supabase cloud):
#   DATABASE_URL = "Transaction pooler" (…pooler.supabase.com:6543/postgres),
#                  añadiéndole  ?pgbouncer=true&connection_limit=1
#   DIRECT_URL   = "Session / Direct"   (db.<ref>.supabase.co:5432/postgres)
#                  — solo lo usa `prisma migrate`.

# --- Telegram ---
# Token que da @BotFather al crear el bot.
TELEGRAM_BOT_TOKEN=""
# Cadena aleatoria que tú eliges. Valida el header X-Telegram-Bot-Api-Secret-Token
# del webhook y también protege el endpoint dev (header X-Dev-Secret).
TELEGRAM_WEBHOOK_SECRET=""
# chat.id autorizado como proveedor (envía documentos y el comando "NO").
PROVEEDOR_TELEGRAM_CHAT_ID=""
# chat.id que recibe todas las notificaciones de administración.
ADMIN_TELEGRAM_CHAT_ID=""

# URL pública del despliegue (Vercel). La usa `npm run webhook:set` para
# registrar el webhook: <WEBHOOK_BASE_URL>/api/telegram/webhook
WEBHOOK_BASE_URL=""

# --- Auth.js (paneles /proveedor y /admin) ---
# Secreto para firmar el JWT de sesión. Genera uno con: npx auth secret
AUTH_SECRET=""
