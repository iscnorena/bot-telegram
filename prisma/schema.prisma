// Bot de Telegram para gestoría de acta de nacimiento.
// Regla de arquitectura: NUNCA se persiste el PDF del acta; solo se guarda el
// `file_id` de Telegram como referencia.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Solicitud {
  id                 Int             @id @default(autoincrement())
  chatIdUsuario      BigInt          @map("chat_id_usuario")
  curp               String          @db.VarChar(18) // se guarda SIEMPRE normalizada a mayúsculas
  nombre             String?
  apellidoPaterno    String?         @map("apellido_paterno")
  apellidoMaterno    String?         @map("apellido_materno")
  estado             EstadoSolicitud @default(pendiente_curp)
  servicioId         Int?            @map("servicio_id") // null = servicio por defecto
  metodoEntrega      String?         @map("metodo_entrega") // 'telegram_proveedor' | 'panel_web'
  fileIdEntregado    String?         @map("file_id_entregado") // solo referencia de Telegram, nunca el archivo
  proveedorId        Int?            @map("proveedor_id") // Usuario con rol 'proveedor'
  pagadoAt           DateTime?       @map("pagado_at")
  enviadoProveedorAt DateTime?       @map("enviado_proveedor_at")
  entregadoAt        DateTime?       @map("entregado_at")

  // Conciliación semanal contra la factura del proveedor
  costoProveedorEsperado Decimal?  @db.Decimal(10, 2) @map("costo_proveedor_esperado") // congelado al cerrar el corte
  costoProveedorReal     Decimal?  @db.Decimal(10, 2) @map("costo_proveedor_real")     // captura manual del admin
  facturadoAt            DateTime? @map("facturado_at")
  facturadoPor           Int?      @map("facturado_por")
  corteId               Int?      @map("corte_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  logs     SolicitudLog[]
  servicio Servicio?      @relation(fields: [servicioId], references: [id])
  proveedor Usuario?      @relation(fields: [proveedorId], references: [id])
  corte    Corte?         @relation(fields: [corteId], references: [id])

  @@index([curp])
  @@index([chatIdUsuario])
  @@index([estado])
  @@index([entregadoAt])
  @@map("solicitudes")
}

enum EstadoSolicitud {
  pendiente_curp
  pagado
  enviado_proveedor
  entregando // transitorio: una entrega fue reclamada y sendDocument está en curso
  no_encontrado_proveedor // interno: el proveedor no lo encontró, pero puede reintentar
  entregado // cerrado
  no_encontrado // cerrado (final, se avisa al usuario)
}

model SolicitudLog {
  id          Int      @id @default(autoincrement())
  solicitudId Int      @map("solicitud_id")
  canal       String // 'telegram_proveedor' | 'panel_web' | 'sistema' | 'admin'
  accion      String
  detalle     String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  solicitud Solicitud @relation(fields: [solicitudId], references: [id])

  @@index([solicitudId])
  @@map("solicitud_logs")
}

model Usuario {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String   @map("password_hash")
  nombre       String
  rol          String   @default("proveedor") // 'admin' | 'proveedor'
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tarifas     Tarifa[]
  solicitudes Solicitud[]

  @@map("usuarios")
}

// Estado de la conversación de Telegram por chat (Telegram no guarda estado).
model Conversacion {
  chatId      BigInt   @id @map("chat_id")
  paso        String   @default("menu") // menu | esperando_curp | esperando_curp_consulta
  solicitudId Int?     @map("solicitud_id")
  intentos    Int      @default(0) // reintentos de CURP inválida en el paso actual
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("conversaciones")
}

model Servicio {
  id            Int      @id @default(autoincrement())
  slug          String   @unique // 'acta_nacimiento'
  nombre        String
  precioUsuario Decimal  @db.Decimal(10, 2) @map("precio_usuario")
  activo        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tarifas     Tarifa[]
  solicitudes Solicitud[]

  @@map("servicios")
}

// Costo que cobra el proveedor por trámite, con historial de vigencias.
model Tarifa {
  id           Int       @id @default(autoincrement())
  usuarioId    Int       @map("usuario_id") // proveedor
  servicioId   Int       @map("servicio_id")
  monto        Decimal   @db.Decimal(10, 2)
  vigenteDesde DateTime  @map("vigente_desde")
  vigenteHasta DateTime? @map("vigente_hasta") // null = vigente
  createdAt    DateTime  @default(now()) @map("created_at")

  usuario  Usuario  @relation(fields: [usuarioId], references: [id])
  servicio Servicio @relation(fields: [servicioId], references: [id])

  @@index([usuarioId, servicioId, vigenteDesde])
  @@map("tarifas")
}

// Corte semanal (lunes–domingo, hora de Ciudad de México) para conciliar.
model Corte {
  id              Int       @id @default(autoincrement())
  inicio          DateTime // lunes 00:00 CDMX, guardado en UTC
  fin             DateTime // domingo 23:59:59.999 CDMX, guardado en UTC
  cerradoAt       DateTime? @map("cerrado_at")
  cerradoPor      Int?      @map("cerrado_por")
  totalEntregadas Int?      @map("total_entregadas")
  totalEsperado   Decimal?  @db.Decimal(12, 2) @map("total_esperado")
  totalReal       Decimal?  @db.Decimal(12, 2) @map("total_real")
  totalDiferencia Decimal?  @db.Decimal(12, 2) @map("total_diferencia")
  createdAt       DateTime  @default(now()) @map("created_at")

  solicitudes Solicitud[]

  @@unique([inicio, fin])
  @@map("cortes")
}
